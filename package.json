{
	"name": "timan",
	"version": "2.0.0-dev",
	"description": "World time in the terminal, inspired by the Casio AE-1200WH.",
	"type": "module",
	"bin": {
		"timan": "dist/main.js"
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"typecheck": "tsc --noEmit",
		"test": "node --test \"test/**/*.test.ts\"",
		"gen:map": "node scripts/gen-map.ts",
		"test:update": "node --test --test-update-snapshots \"test/**/*.test.ts\""
	},
	"engines": {
		"node": ">=24"
	},
	"keywords": [
		"timan",
		"timezone",
		"terminal",
		"world-time"
	],
	"author": "Israel Júnior <israeljunior.net@gmail.com>",
	"license": "MIT",
	"devDependencies": {
		"@types/node": "^24.19.0",
		"typescript": "^7.0.2"
	}
}
